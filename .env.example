# Copy to .env and fill in. .env is gitignored; this file is not.

# Required. Value for the X-Api-Key header on POST /api/sync.
# Generate one with:  openssl rand -hex 24
API_KEY=replace-me

# Host port to publish the API on (container always listens on 8080).
API_PORT=8080

# Background RSS sync. Episodes are released on Tuesdays, so the job runs
# every SYNC_INTERVAL_HOURS during SYNC_DAYS and idles the rest of the week.
# Slots are aligned to midnight in SYNC_TIMEZONE (00:00, 03:00, 06:00, ...).
SYNC_ENABLED=true
SYNC_DAYS=Tuesday
SYNC_INTERVAL_HOURS=3
SYNC_TIMEZONE=Europe/Madrid
